{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinepix",
  "version": "5.6.0",
  "identifier": "com.cinepix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cinepix",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "frameworks": []
    },
    "linux": {
      "deb": {
        "depends": ["libmpv2", "mpv"]
      }
    },
    "android": {
      "versionCode": 15
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shanto100files/cinepix_tv/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCNEQxMTZDNUI4OTg1RjAKUldUd2hZbGJiQkZOYTYxY0R4VW5ydHdzSlZaZkNPeGx5RTVhR0tZTGxIR1NmYWM4UnRjd2JySlMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
